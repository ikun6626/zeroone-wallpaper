{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "storeFile": "<SIGNING_DIR>/release.p12",
          "storePassword": "<REDACTED>",
          "keyAlias": "zeroone",
          "keyPassword": "<REDACTED>",
          "signAlg": "SHA256withECDSA",
          "profile": "<SIGNING_DIR>/fabuRelease.p7b",
          "certpath": "<SIGNING_DIR>/zeroone.cer"
        }
      },
      {
        "name": "release",
        "type": "HarmonyOS",
        "material": {
          "storeFile": "<SIGNING_DIR>/zeroonekey.p12",
          "storePassword": "<REDACTED>",
          "keyAlias": "debugKey",
          "keyPassword": "<REDACTED>",
          "signAlg": "SHA256withECDSA",
          "profile": "<SIGNING_DIR>/zeroone-wallpaperRelease.p7b",
          "certpath": "<SIGNING_DIR>/zeroone.cer"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "6.1.1(24)",
        "compatibleSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}