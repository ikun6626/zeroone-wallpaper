# ===== 以下为后续追加，避免把本机产物/敏感材料写进仓库 =====

# 签名与密钥材料（绝不入库；正式签名请放在 ~/.ohos/config 下由 DevEco 管理）
/zeroonekey.p12
/zeroone.csr
*.p12
*.csr
*.p7b
*.cer

# DevEco Studio 素材缓存（可重新生成）
/material

# 与本工程无关的独立 npm 包（DSH Web 皮肤管理器，自带 LICENSE/package.json，应独立成仓）
/dsh-deep-whale

# 云存储上传包（由 tools/prepare_cloud_assets.py 生成，几十 MB，不入库）
/assets-out/

# 仓库目录自身（Codex 沙箱不允许工作区存在 .git，故仓库用 .gitrepo）
/.gitrepo/

# 编辑器自动备份与工具缓存（可重新生成）
/.backup-ets-*/
/.trae/

# ===== 上传 GitHub 前追加（临时产物 / 验收截图 / 分享包）=====
/.tmp/
/.tmp_privacy/
/.trae-html-share-packages/
/.screenshots/
/.backup/
/.workbuddy/
*.tar

# 构建日志与临时截图（本机产物）
*.log
/.tmp-home*.jpeg

# 本机私有配置（含签名材料路径与口令，绝不入库）
/.local/

# ===== 公开仓库不纳入：含凭据 / 个人信息 / 内部申报与运维材料 =====
# 这些文件只保留在本机 .local/private/ 下，禁止再次提交
/docs/隐私政策核对与改写草案-2026-11-07.md
/docs/上架材料-2026-11-07.md
/docs/提交备忘-2026-11-07.md
